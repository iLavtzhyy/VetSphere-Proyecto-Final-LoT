# ── VetSphere · Backend (Spring Boot) ───────────────────────────────────────
# Copia este archivo a .env local y asigna secretos nuevos y únicos.
# NUNCA subas el archivo .env al repositorio.

# ── Base de datos (SQL Server) ──────────────────────────────────────────────
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=VeterinariaDB;encrypt=true;trustServerCertificate=false
DB_USERNAME=
DB_PASSWORD=

# ── Autenticación JWT ───────────────────────────────────────────────────────
# Genera un secreto aleatorio de al menos 32 bytes; nunca lo reutilices.
JWT_SECRET=
# Duración del token (por defecto 30 minutos = 1800000 ms).
#JWT_EXPIRATION_MS=1800000

# ── CORS ────────────────────────────────────────────────────────────────────
# Orígenes permitidos para el frontend (coma separado).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ── Seguridad del servicio SOAP (WS-Security UsernameToken) ────────────────
SOAP_USERNAME=
SOAP_PASSWORD=

# ── Registro de personal ────────────────────────────────────────────────────
# Código que el administrador comparte al personal para registrarse.
ADMIN_REGISTRATION_CODE=

# ── Datos de demostración ───────────────────────────────────────────────────
# Si se define, el perfil "local" siembra datos de demostración al arrancar.
DEMO_SEED_PASSWORD=

# ── Correo transaccional (códigos 2FA y recuperación de contraseña) ────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Asistente de IA (endpoint POST /api/chat) ──────────────────────────────
# Clave de una API compatible con OpenAI (CodeCraft API, OpenAI, DeepSeek, Groq, LM Studio, etc.).
# Si se deja vacío, el asistente responde que no está configurado (no falla).
CHAT_API_KEY=
#URL base del proveedor compatible con OpenAI (por defecto la de OpenAI).
#CHAT_BASE_URL=https://api.openai.com/v1
#CHAT_BASE_URL=https://codecraftapi.com/v1
#Modelo a utilizar (por defecto gpt-4o-mini).
#CHAT_MODEL=gpt-4o-mini
PICHINCHA_NUMERO_CUENTA=
PICHINCHA_TITULAR=
PICHINCHA_IDENTIFICACION=
